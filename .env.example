# ---------------------------------------------------------------
# AI Lead Research & Qualification Agent — environment template
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------

# PostgreSQL connection string
DATABASE_URL=postgres://leadagent:leadagent@localhost:5432/lead_agent
# Used only by the integration tests (tables are truncated between tests)
TEST_DATABASE_URL=postgres://leadagent:leadagent@localhost:5432/lead_agent_test

# Session signing secret — at least 32 random characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string-of-at-least-32-chars

# Admin account created by `npm run db:seed`
SEED_ADMIN_EMAIL=admin@novaflow.demo
SEED_ADMIN_PASSWORD=change-me-demo-password

# Show the demo credentials on the login page (set false in any shared deployment)
SHOW_DEMO_CREDENTIALS=true

# ---------------- AI provider ----------------
# mock | openai   ("openai" = any OpenAI-compatible Chat Completions endpoint)
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ---------------- Research provider ----------------
# mock | web   ("web" = live website analysis with SSRF-guarded fetching)
RESEARCH_PROVIDER=mock
# Optional web search used by the "web" research provider: none | tavily
WEB_SEARCH_PROVIDER=none
TAVILY_API_KEY=

# Website fetch limits
FETCH_TIMEOUT_MS=8000
FETCH_MAX_BYTES=1500000
FETCH_MAX_PAGES=4
FETCH_USER_AGENT=NovaFlowLeadResearchBot/0.1 (+https://example.com/bot)

# ---------------- Processing ----------------
# Max leads processed at the same time (bulk import). Keep small.
LEAD_CONCURRENCY=2
# Artificial per-tool delay in mock mode so the demo progress is visible (0 to disable)
MOCK_LATENCY_MS=350
